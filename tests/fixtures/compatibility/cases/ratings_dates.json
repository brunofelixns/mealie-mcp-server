[
  {
    "tool": "set_recipe_rating",
    "arguments": {
      "slug": "soup",
      "rating": 4.5,
      "isFavorite": false
    },
    "scenario": "set_recipe_rating.basic",
    "expected_requests": [
      {
        "method": "GET",
        "path": "/api/users/self",
        "query": {},
        "body": null
      },
      {
        "method": "POST",
        "path": "/api/users/u1/ratings/soup",
        "query": {},
        "body": {
          "rating": 4.5,
          "isFavorite": false
        }
      },
      {
        "method": "GET",
        "path": "/api/recipes/soup",
        "query": {},
        "body": null
      },
      {
        "method": "GET",
        "path": "/api/users/self/ratings/r1",
        "query": {},
        "body": null
      }
    ],
    "expected_result": {
      "content": [
        {
          "type": "text",
          "text": "{\"userRating\":{\"recipeId\":\"r1\",\"rating\":4.5,\"isFavorite\":false,\"extra\":{\"keep\":true}},\"recipeRating\":4.5}"
        }
      ]
    }
  },
  {
    "tool": "mark_recipe_last_made",
    "arguments": {
      "slug": "soup",
      "timestamp": "2026-01-10T18:45:00+02:00"
    },
    "scenario": "mark_recipe_last_made.basic",
    "expected_requests": [
      {
        "method": "PATCH",
        "path": "/api/recipes/soup/last-made",
        "query": {},
        "body": {
          "timestamp": "2026-01-10T16:45:00.000Z"
        }
      }
    ],
    "expected_result": {
      "content": [
        {
          "type": "text",
          "text": "{\"slug\":\"soup\",\"lastMade\":\"2026-01-10T16:45:00.000Z\"}"
        }
      ]
    }
  },
