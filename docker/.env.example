# Nombre del servicio Compose; cambiarlo para otra instancia independiente.
COMPOSE_PROJECT_NAME=mealie-mcp

# Imagen que publicará release.yaml: ghcr.io/<propietario>/<repositorio>:<version>.
# Cambiar el propietario si se publica desde otro fork; no usar la imagen upstream Node.
MEALIE_MCP_IMAGE=ghcr.io/brunofelixns/mealie-mcp-server:2.1.0

# URL alcanzable desde el contenedor, incluida la subruta si existe.
MEALIE_BASE_URL=https://mealie.example.com
MEALIE_API_KEY=

# HTTP: token distinto de la API key Mealie, generado con al menos 32 bytes aleatorios.
# Obligatorio para HTTP; stdio no lo utiliza. No reutilizar un valor de ejemplo.
MCP_AUTH_TOKEN=
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_REQUIRE_HTTPS=true

# Puerto interno 8000; publicar en loopback para un proxy TLS en este host.
MCP_BIND_IP=127.0.0.1
MCP_PUBLISHED_PORT=8000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=

TZ=Europe/Madrid
LOG_LEVEL=INFO
MEALIE_MCP_DEBUG=false
