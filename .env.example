# Mealie credentials, injected explicitly by the client or container.
MEALIE_BASE_URL=http://mealie:9000
MEALIE_API_KEY=
# Alternative: set MEALIE_API_KEY_FILE, never both.

MCP_TRANSPORT=stdio
TZ=UTC
MEALIE_MCP_DEBUG=false
LOG_LEVEL=INFO

# HTTP only: use a separate random token (at least 32 visible ASCII characters).
# MCP_AUTH_TOKEN_FILE=/run/secrets/mcp_auth_token
# MCP_PUBLIC_URL=https://mcp.example.com/mcp
# MCP_REQUIRE_HTTPS=true
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://client.example.com
